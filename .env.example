PORT=3000
VENDOR_SCOUT_DATA_PATH=data/runtime.json

# Required for production mission mutations. Leave blank only for local development.
VENDOR_SCOUT_AGENT_TOKEN=

# Optional separate bearer token for the /mcp endpoint. When omitted, the MCP
# endpoint reuses VENDOR_SCOUT_AGENT_TOKEN. Configure the same bearer header in
# the TrueForge MCP connector.
VENDOR_SCOUT_MCP_TOKEN=

# Optional executable supplier-discovery provider. The endpoint must accept the
# mission JSON contract and return { "suppliers": [...] }.
VENDOR_SCOUT_DISCOVERY_URL=
VENDOR_SCOUT_DISCOVERY_TOKEN=

# Optional supplier-outreach transport. Vendor Scout POSTs one persisted RFQ at
# a time, includes an Idempotency-Key header, and expects JSON containing a
# delivery status plus an optional provider message ID. Production URLs must use HTTPS.
VENDOR_SCOUT_OUTREACH_URL=
VENDOR_SCOUT_OUTREACH_TOKEN=

# TrueForge server and saved procurement agent. Local TrueForge defaults to
# http://localhost:8790; hosted/OIDC deployments also require TRUEFORGE_TOKEN.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_AGENT_NAME=vendor-scout
TRUEFORGE_TOKEN=

# Production defaults are safe: no fixture discovery fallback, no simulated
# outreach preview, and no dev reset unless each is explicitly enabled.
VENDOR_SCOUT_ALLOW_FIXTURE_FALLBACK=0
VENDOR_SCOUT_ALLOW_OUTREACH_PREVIEW=0
VENDOR_SCOUT_ENABLE_DEV_RESET=0
